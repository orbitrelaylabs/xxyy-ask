# Chat / planner
# REQUIRED for API chat, CLI provider-backed ask/eval, and Telegram bot.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPTIONAL Docker Compose override when OPENAI_BASE_URL points to a service on the host.
# Docker Desktop exposes the host as host.docker.internal.
COMPOSE_OPENAI_BASE_URL=

# Embeddings
# OPTIONAL overrides let embeddings use a different OpenAI-compatible provider.
# When blank, they fall back to OPENAI_API_KEY and OPENAI_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_REQUEST_TIMEOUT_MS=30000
EVAL_JUDGE_MODEL=

OPENAI_MAX_RETRIES=1

# RAG behavior
# OPTIONAL.
RAG_TOP_K=6

# Answer-quality rollout. Each channel can be optimized, legacy, or shadow.
# Shadow returns only the selected primary answer and records a bounded,
# redacted comparison. The percentage is an integer from 0 to 100.
# Enable structured rollout observations before any shadow or gray window.
# Events contain no question, answer, user ID, session ID, or request ID.
ANSWER_QUALITY_OBSERVABILITY_ENABLED=false
ANSWER_QUALITY_WEB_MODE=optimized
ANSWER_QUALITY_WEB_OPTIMIZED_PERCENTAGE=100
ANSWER_QUALITY_TELEGRAM_MODE=optimized
ANSWER_QUALITY_TELEGRAM_OPTIMIZED_PERCENTAGE=100
ANSWER_QUALITY_CLI_MODE=optimized
ANSWER_QUALITY_CLI_OPTIMIZED_PERCENTAGE=100

# Public Web/Telegram status display for the external scheduler-safe refresh job.
# Set enabled only after the scheduler is installed and the receipt directory is
# readable by the customer-facing containers.
KNOWLEDGE_AUTO_REFRESH_ENABLED=false
KNOWLEDGE_AUTO_REFRESH_INCREMENTAL_DAILY_AT=08:00
KNOWLEDGE_AUTO_REFRESH_TIME_ZONE=Asia/Shanghai
KNOWLEDGE_AUTO_REFRESH_STALE_AFTER_MINUTES=1560
KNOWLEDGE_AUTO_REFRESH_RECEIPT_FILE=.rag/knowledge-refresh/latest.json

# Database
# REQUIRED for product RAG retrieval, ingest, sync, stats, migrations, API chat, and Telegram bot.
# Use either DATABASE_URL, or POSTGRES_DB + POSTGRES_USER + POSTGRES_PASSWORD.
# DATABASE_URL=postgres://xxyy:replace_me_with_a_strong_password@localhost:5432/xxyy_ask
# OPTIONAL only for Docker Compose when using an external database reachable from containers.
# COMPOSE_DATABASE_URL=postgres://xxyy:replace_me_with_a_strong_password@db.example.com:5432/xxyy_ask
POSTGRES_DB=xxyy_ask
POSTGRES_USER=xxyy
POSTGRES_PASSWORD=replace_me_with_a_strong_password

# OPTIONAL when using POSTGRES_*; defaults are localhost:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# XXYY transaction diagnosis. Pool classification is independent from canonical-pool
# matching. A pool is "small" only when both the absolute USD threshold and the
# relative-to-dominant threshold match policy v1.0.0.
XXYY_SMALL_POOL_MAX_LIQUIDITY_USD=10000
XXYY_SMALL_POOL_MAX_RELATIVE_LIQUIDITY_PPM=100000
# Optional governed canonical declarations. Highest liquidity is never treated as
# canonical automatically. Example:
# {"entries":[{"chain":"solana:mainnet","tokenAddress":"...","pairAddress":"..."}]}
XXYY_CANONICAL_POOL_CONFIG_JSON='{"entries":[]}'

# Optional screenshot evidence. Configure Chrome and one isolated artifact directory.
# Web serves hash-addressed PNG files from the same-origin /xxyy-evidence/ route;
# Telegram reads the same directory and uploads the PNG bytes directly.
XXYY_SCREENSHOT_CHROME_EXECUTABLE=
XXYY_SCREENSHOT_DIRECTORY=
# Browser-only public chain evidence. Use an isolated persistent Chrome profile and
# complete any Explorer verification in it before starting API/Telegram. Chrome is
# auto-detected when the executable above is empty. No RPC configuration is accepted.
XXYY_BROWSER_PROFILE_DIRECTORY=

# API service
# OPTIONAL service runtime.
# PORT=3000
# NODE_ENV=development
# Docker Compose binds to loopback by default. Use 0.0.0.0 only behind a firewall or reverse proxy.
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
POSTGRES_BIND_HOST=127.0.0.1
API_CORS_ORIGIN=
API_ENABLE_DEEP_HEALTH=
API_MAX_BODY_BYTES=65536
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false

# Versioned /api/v1 Agent API is disabled while this is empty.
# Generate an integration key with: pnpm agent:api-key:create -- partner-service
XXYY_AGENT_API_KEYS_JSON=

# Optional client-side variables for skills/xxyy-product-support/scripts/ask.mjs.
XXYY_SUPPORT_API_BASE_URL=http://127.0.0.1:3000
XXYY_SUPPORT_API_KEY=

# Knowledge administration is disabled while this is empty.
# Create the first database-backed administrator from GET /admin.
KNOWLEDGE_ADMIN_MAX_BODY_BYTES=5242880
KNOWLEDGE_ADMIN_RATE_LIMIT_MAX=30
KNOWLEDGE_ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Telegram bot
# REQUIRED only when running pnpm run telegram:dev.
TELEGRAM_BOT_TOKEN=
# Group replies are disabled by default. The bot still writes visible group text
# to the local Inbox, but sends no group output.
TELEGRAM_GROUP_RESPONSES_ENABLED=false
# Local raw-message retention for the Telegram Inbox (1-365 days).
TELEGRAM_GROUP_MESSAGE_RETENTION_DAYS=30
TELEGRAM_CURATION_DEBOUNCE_SECONDS=30
TELEGRAM_CURATION_WORKER_POLL_MS=1000
# OPTIONAL override for Knowledge Curator getChatAdministrators; defaults to Telegram Bot API.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# OPTIONAL outbound proxy for the Telegram container. Node 24 only reads the
# standard proxy variables when NODE_USE_ENV_PROXY is enabled.
TELEGRAM_NODE_USE_ENV_PROXY=
TELEGRAM_HTTPS_PROXY=
TELEGRAM_HTTP_PROXY=
TELEGRAM_NO_PROXY=postgres,localhost,127.0.0.1

# OPTIONAL Telegram runtime.
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_POLL_ERROR_RETRY_MS=3000
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_UPDATES_LIMIT=100

# Local app startup helper
# OPTIONAL.
XXYY_START_MODE=local
XXYY_SKIP_DOCKER=false

# X / Twitter update scraper
# OPTIONAL.
XXYY_X_MAX_PAGES=100
XXYY_X_PAGE_SIZE=40
XXYY_X_REQUEST_DELAY_MS=250

# Documentation media enrichment
# OPTIONAL. auto uses macOS Vision when available, then Tesseract.
MEDIA_OCR_PROVIDER=auto
MEDIA_OCR_LANGS=chi_sim+eng
MEDIA_VIDEO_FRAME_INTERVAL_SECONDS=2
MEDIA_FORCE=false
# Fail docs:enrich:media when any configured video itself cannot be extracted,
# even when its product knowledge is already covered by verified surrounding text.
MEDIA_REQUIRE_ALL=false
# Optional explicit yt-dlp executable. When blank, yt-dlp or uvx is detected.
MEDIA_YTDLP_PATH=
# Optional and intentionally disabled: may prompt for the browser keychain.
MEDIA_YTDLP_COOKIES_FROM_BROWSER=
# Required only for videos without public captions; API key/base URL fall back to OPENAI_*.
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=

# Agent smoke test
# OPTIONAL.
API_SMOKE_BASE_URL=http://127.0.0.1:3000
API_SMOKE_PRODUCT_QUESTION=XXYY Pro 有哪些权益？
API_SMOKE_BOUNDARY_QUESTION=帮我查一下钱包余额

# Workspace resolution
# OPTIONAL advanced setting. Usually provided by pnpm; normally leave unset.
# INIT_CWD=/absolute/path/to/xxyy-ask
