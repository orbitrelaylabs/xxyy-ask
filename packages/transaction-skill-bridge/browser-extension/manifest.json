{
  "manifest_version": 3,
  "name": "XXYY Browser Connector",
  "version": "1.0.0",
  "description": "Connects the current Chrome profile to the XXYY support runtime for fixed Explorer and XXYY page reads.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["nativeMessaging", "scripting", "storage"],
  "host_permissions": [
    "https://basescan.org/tx/*",
    "https://www.basescan.org/tx/*",
    "https://base.blockscout.com/tx/*",
    "https://bscscan.com/tx/*",
    "https://www.bscscan.com/tx/*",
    "https://eth.blockscout.com/tx/*",
    "https://robinhoodchain.blockscout.com/tx/*",
    "https://solscan.io/tx/*",
    "https://www.solscan.io/tx/*",
    "https://stablescan.xyz/tx/*",
    "https://www.stablescan.xyz/tx/*",
    "https://xxyy.io/*",
    "https://www.xxyy.io/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XXYY Browser Connector"
  }
}
