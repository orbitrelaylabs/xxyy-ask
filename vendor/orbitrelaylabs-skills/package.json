{
  "name": "@orbitrelaylabs/xxyy-transaction-skills",
  "version": "0.1.0",
  "description": "Self-contained browser Skills for public transaction inspection and evidence-bounded XXYY trade diagnosis",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitrelaylabs/skills.git"
  },
  "homepage": "https://github.com/orbitrelaylabs/skills#readme",
  "bugs": {
    "url": "https://github.com/orbitrelaylabs/skills/issues"
  },
  "bin": {
    "onchain-inspect": "./skills/onchain-transaction-inspector/scripts/inspect.mjs",
    "xxyy-diagnose": "./skills/xxyy-transaction-diagnosis/scripts/diagnose.mjs"
  },
  "scripts": {
    "build": "pnpm skills:build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "onchain:inspect": "tsx src/runtime/transaction-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "skills:build": "pnpm skills:build:onchain && pnpm skills:build:xxyy && node scripts/normalize-bundles.mjs",
    "skills:build:onchain": "esbuild src/runtime/transaction-cli.ts --bundle --platform=node --format=esm --target=node24 --tree-shaking=true --legal-comments=none --outfile=skills/onchain-transaction-inspector/scripts/inspect.mjs",
    "skills:build:xxyy": "esbuild src/runtime/cli.ts --bundle --platform=node --format=esm --target=node24 --tree-shaking=true --legal-comments=none --outfile=skills/xxyy-transaction-diagnosis/scripts/diagnose.mjs",
    "xxyy:diagnose": "tsx src/runtime/cli.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.17.0"
}
